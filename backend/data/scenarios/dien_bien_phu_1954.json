  "timeline_steps": [
    {
      "step_id": "step_01_opening",
      "step_index": 0,
      "timestamp_label": "13/03/1954 - 17:05",
      "title": "Phát súng mở màn: Tiêu diệt cứ điểm Him Lam (Béatrice)",
      "phase_name": "Đợt 1: Đột phá cánh bắc & đông bắc",
      "tactical_objective": "Hạ gục cứ điểm kiên cố nhất bảo vệ phía đông bắc, mở then chốt tiến vào thung lũng Mường Thanh.",
      "camera": {
        "center": [103.0450, 21.4080],
        "zoom": 13.5,
        "pitch": 58.0,
        "bearing": -35.0,
        "duration_sec": 14.0,
        "easing": "easeInOutCubic"
      },
      "start_time": 0.0,
      "end_time": 14.5,
      "duration_sec": 14.5,
      "narration_text": "17 giờ 5 phút ngày 13 tháng 3 năm 1954, hàng chục khẩu trọng pháo 105 ly của Đại đoàn 351 bất ngờ gầm vang từ các sườn núi cao bao bọc thung lũng, trút bão lửa xuống cứ điểm Him Lam. Mũi xung kích Đại đoàn 312 lập tức mở cửa đột phá, tiêu diệt hoàn toàn cứ điểm kiên cố nhất của Pháp sau vài giờ kịch chiến.",
      "active_unit_ids": ["unit_f351_artillery", "unit_f312", "unit_beatrice"],
      "active_arrow_ids": ["arrow_f351_artillery", "arrow_f312_assault"],
      "active_combat_ids": ["combat_him_lam_fire"],
      "active_territory_ids": ["territory_french_initial"],
      "factions_status": {
        "viet_minh": { "current_manpower": 54800, "casualties": 200 },
        "french_army": { "current_manpower": 15450, "casualties": 750 }
      }
    },
    {
      "step_id": "step_02_north_collapse",
      "step_index": 1,
      "timestamp_label": "15/03 - 17/03/1954",
      "title": "Cánh cửa phía Bắc sụp đổ: Đồi Độc Lập & Bản Kéo",
      "phase_name": "Đợt 1: Xóa sổ phân khu Bắc",
      "tactical_objective": "Triệt hạ Cứ điểm Độc Lập và Bản Kéo, khống chế hoàn toàn không vực phía bắc sân bay Mường Thanh.",
      "camera": {
        "center": [103.0080, 21.4280],
        "zoom": 13.2,
        "pitch": 52.0,
        "bearing": 15.0,
        "duration_sec": 12.0,
        "easing": "easeInOutCubic"
      },
      "start_time": 14.5,
      "end_time": 26.5,
      "duration_sec": 12.0,
      "narration_text": "Thừa thắng xông lên, rạng sáng 15 tháng 3, Đại đoàn 308 phối hợp cùng 312 công kích đồi Độc Lập. Dù đối phương phản kích bằng xe tăng và pháo binh, quân ta làm chủ trận địa. Ngày 17 tháng 3, binh lính đồn trú tại Bản Kéo hoảng loạn đầu hàng. Toàn bộ cửa ngõ phía bắc của tập đoàn cứ điểm bị xóa sổ.",
      "active_unit_ids": ["unit_f308", "unit_gabrielle", "unit_anne_marie"],
      "active_arrow_ids": ["arrow_f308_gabrielle"],
      "active_combat_ids": ["combat_gabrielle_clash"],
      "active_territory_ids": ["territory_french_initial"],
      "factions_status": {
        "viet_minh": { "current_manpower": 54300, "casualties": 700 },
        "french_army": { "current_manpower": 14000, "casualties": 2200 }
      }
    },
    {
      "step_id": "step_03_siege_trenches",
      "step_index": 2,
      "timestamp_label": "30/03 - 25/04/1954",
      "title": "Chiến thuật vây lấn: Siết chặt vòng vây chiến hào",
      "phase_name": "Đợt 2: Đào hào bao vây & cắt đứt sân bay",
      "tactical_objective": "Đào hàng trăm km chiến hào siết chặt sân bay, triệt phá hoàn toàn huyết mạch tiếp tế đường không duy nhất của Pháp.",
      "camera": {
        "center": [103.0180, 21.3950],
        "zoom": 13.8,
        "pitch": 62.0,
        "bearing": -10.0,
        "duration_sec": 14.5,
        "easing": "easeInOutCubic"
      },
      "start_time": 26.5,
      "end_time": 41.0,
      "duration_sec": 14.5,
      "narration_text": "Bước sang giai đoạn 2, hàng vạn chiến sĩ ngày đêm đào chiến hào vươn dài hàng trăm cây số như những gọng kìm khổng lồ thắt chặt quanh phân khu Mường Thanh. Đường băng sân bay bị pháo cao xạ khống chế gắt gao, máy bay tiếp tế của Pháp buộc phải thả dù từ độ cao lớn, khiến phần lớn lương thực và đạn dược rơi vào tay quân ta.",
      "active_unit_ids": ["unit_f312", "unit_f308", "unit_f316", "unit_de_castries_hq"],
