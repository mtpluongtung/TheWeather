# ============================================================================
# WEATHERCAST STUDIO - CẤU HÌNH MÔI TRƯỜNG (.env.example)
# Sao chép file này thành .env để tùy chỉnh cấu hình hệ thống:
#   copy .env.example .env
# ============================================================================

# --- 1. CẤU HÌNH SERVER BACKEND ---
APP_HOST=127.0.0.1
APP_PORT=8000
FRONTEND_URL=http://127.0.0.1:5173
DATABASE_PATH=backend/data/weathercast.db
OUTPUT_DIR=backend/output

# --- 2. CẤU HÌNH BẢN ĐỒ ĐỊA LÝ THẬT (MAPLIBRE GL JS) ---
# Nhà cung cấp mặc định: "openfreemap_liberty" (Vector Tile thực tế từ OpenStreetMap, không cần API key)
# Các lựa chọn có sẵn:
#   - openfreemap_liberty : Vector tile 3D sắc nét (https://tiles.openfreemap.org/styles/liberty)
#   - openfreemap_bright  : Vector tile sáng rõ (https://tiles.openfreemap.org/styles/bright)
#   - carto_dark          : Bản đồ truyền hình nền tối (Carto Dark Matter GL)
#   - osm_raster          : Bản đồ OpenStreetMap Raster tiêu chuẩn
#   - maptiler_hybrid     : Bản đồ vệ tinh + nhãn địa lý (Yêu cầu MAPTILER_API_KEY bên dưới)
DEFAULT_MAP_PROVIDER=openfreemap_liberty

# Tùy chọn: Nếu muốn dùng MapTiler (Vệ tinh/Địa hình 3D cao cấp), đăng ký miễn phí tại:
# https://cloud.maptiler.com/account/keys/ và điền key vào dưới đây (Chỉ xử lý qua backend metadata, không hardcode):
MAPTILER_API_KEY=

# Bật/tắt địa hình nổi 3D thật (AWS Open Data Terrain DEM - Terrarium tiles, không cần API key)
ENABLE_REAL_3D_TERRAIN=true

# --- 3. NGUỒN DỮ LIỆU THỜI TIẾT THỰC TẾ ---
OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1/forecast
RAINVIEWER_API_URL=https://api.rainviewer.com/public/weather-maps.json
NCHMF_REFERENCE_URL=https://www.nchmf.gov.vn/kttv/
WEATHER_API_TIMEOUT_SEC=15
WEATHER_API_MAX_RETRIES=3
WEATHER_CACHE_TTL_SECONDS=600

# --- 4. CẤU HÌNH AI VIẾT LỜI DẪN (TÙY CHỌN LLM ADAPTER) ---
# Nếu để trống LLM_API_KEY, hệ thống tự động sử dụng Controlled Broadcast Template Engine
# đảm bảo 100% số liệu chính xác từ API thời tiết thật mà không cần khóa API.
# Hỗ trợ: "none" | "gemini" | "openai_compatible"
LLM_PROVIDER=none
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# --- 5. CẤU HÌNH GIỌNG ĐỌC TIẾNG VIỆT (TTS) ---
# Mặc định sử dụng Microsoft Edge Neural TTS tiếng Việt (miễn phí, tự nhiên):
#   - vi-VN-HoaiMyNeural  (Giọng nữ biên tập viên truyền hình)
#   - vi-VN-NamMinhNeural (Giọng nam biên tập viên truyền hình)
DEFAULT_TTS_VOICE=vi-VN-HoaiMyNeural
DEFAULT_TTS_RATE=+0%

# --- 6. CẤU HÌNH RENDER VIDEO MP4 (PLAYWRIGHT + FFMPEG) ---
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
# Chế độ trình duyệt khi ghi hình bản đồ MapLibre:
#   true  = Chạy Chromium headless kèm cờ GPU/WebGL (d3d11 / swiftshader)
#   false = Mở cửa sổ Chromium trực tiếp (Hữu ích nếu driver GPU chặn WebGL ở chế độ ẩn)
PLAYWRIGHT_HEADLESS=true
# Chế độ GPU cho Chromium trên Windows: "d3d11" (khuyên dùng trên Windows 10/11) hoặc "swiftshader" (software WebGL)
PLAYWRIGHT_GL_BACKEND=d3d11
RENDER_FPS=30
MAX_RENDER_DURATION_SEC=180
MAX_CONCURRENT_RENDERS=1
